#!/usr/bin/env bash

set -e

optRating=''

# TODO add a way to queue tag updates

for arg in "$@"
do
	# super short version
	if [[ "${arg,,}" =~ ^\-?[dkl]$ ]]
	then
		arg="${arg: -1}"
		case "${arg,,}" in
			d)
				arg='dump'
				;;
			k)
				arg='keep'
				;;
			l)
				arg='like'
				;;
			esac
	fi

	if [[ "${arg,,}" =~ ^\-?\-?(dump|keep|like|love)$ ]]
	then
		optRating="${arg,,}"
	else
		echo "I have no idea what $arg" means
	fi
done

if [[ "${optRating,,}" =~ ^(like|love)$ ]]
then
	likeArg=(--like)
else
	likeArg=(--what)
fi

logPath="$HOME/.logs/music-ratings.json"

runAndVal(){
	local command="$1"
	shift
	output="$($command "$@" || true)"

	# what command was sent and what output returned
	# echo "$command $*: $output" >&2

	if [[ "$output" == '{'*'}' ]]
	then
		echo "$output"
	else
		return 1
	fi
}

trackJson="$(runAndVal "$HOME/bin/now-playing-local" --no-online --json \
	|| runAndVal "$HOME/bin/xspot" "${likeArg[@]}" --json \
	|| runAndVal "$HOME/bin/xma" "${likeArg[@]}" --json \
	|| true)"

if [[ -z "$trackJson" ]]
then
	exit
fi

# log here
if [[ -n "$rating" ]]
then
	trackJson="$(echo "$trackJson" | jq -c --arg rating "$optRating" '. + {rating: $rating}')"
	echo "$trackJson" >> "$logPath"
fi

echo "$trackJson" | jq -r '.prettyString'

