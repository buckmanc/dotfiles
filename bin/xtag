#!/usr/bin/env bash

set -e

optPaths=()
optTagName=""
optTagValue=""
optIgnoreBlankValue=0
optNoOverwrites=0
badTagRegex='(\-rw\-rw\-|audio/mpeg|Joint Stereo|LAME3\.|image/jpeg|\(Binary data \d+ bytes)'

for arg in "$@"
do
	if [[ "$arg" =~ ^\-\-ignore\-blank(\-values?)?$ ]]
	then
		optIgnoreBlankValue=1
	elif [[ "$arg" =~ ^\-\-no-overwrites?$ ]]
	then
		optNoOverwrites=1
	elif [[ -f "$arg" ]]
	then
		optPaths+=("$arg")
	elif [[ -z "$optTagName" ]]
	then
		optTagName="$arg"
	elif [[ -z "$optTagValue" ]]
	then
		optTagValue="$arg"
	else
		echo "I have no idea what $arg means"
		exit 1
	fi
done

if [[ "${#optPaths[@]}" -eq 0 || -z "$optTagName" ]]
then
	echo "need path, tag name"
	echo "optPaths: ${optPaths[*]}"
	echo "optTagName: $optTagName"
	echo "optTagValue: $optTagValue"
	exit 1
fi

# for automated situations where the tag may be missing but you don't intend to wipe it
if [[ "$optIgnoreBlankValue" == 1 && -z "$optTagValue" ]]
then
	exit 0
fi

for optPath in "${optPaths[@]}"
do

	if [[ -z "$optPath" ]]
	then
		continue
	fi

	# echo "optPath: $optPath"
	# echo "optTagName: $optTagName"
	# echo "optTagValue: $optTagValue"
	# exit 1
	
	# echo "$optPath"
	
	existingValue="$(exiftool -T -"$optTagName" "$optPath")"

	# alt tag names
	if [[ -z "$existingValue" || "$existingValue" == '-' ]] && [[ "${optTagName,,}" == "albumartist" ]]
	then
		existingValue="$(exiftool -T -"band" "$optPath")"
	fi

	if [[ "$optNoOverwrites" == 1 && -n "$existingValue" ]]
	then
		continue
	fi

	# if a tag isn't natively supported by exiftool it spits out all values, thus ensuring it'll *never* match
	# fallback to manually pulling out the value we want
	if echo "$existingValue" | grep -Piq "$badTagRegex"
	then
		echo "using exiftool fallback method"
		existingValue="$(exiftool "$optPath" | grep -iPo "^${optTagName}+?: \\K.+$" || true)"
	fi

	# if [[ -n "$existingValue" ]]
	# then
	# 	echo "existing $optTagName: $existingValue"
	# fi

	if [[ "$existingValue" == "$optTagValue" ]]
	then
		# echo 'gtg'
		continue
	# else
	# 	basename "$optPath"
	# 	echo "existingValue: $existingValue"
	# 	echo "optTagValue: $optTagValue"
	fi

	fileNameFull="$(basename "$optPath")"
	fileExt="${fileNameFull##*.}"

	# ffmpeg destroys tags, do not use
	
	if [[ "${fileExt,,}" == "mp3" ]]
	then
		# map some tags from descriptions to id3 frames
		# only supported for id3 v2.7
		if [[ "${optTagName,,}" == "mood" ]]
		then
			optTagName=TMOO
		elif [[ "${optTagName,,}" == "grouping" ]]
		then
			optTagName=TIT1
		elif [[ "${optTagName,,}" == "albumartist" ]]
		then
			optTagName=TPE2
		elif [[ "${optTagName,,}" == "genre" ]]
		then
			optTagName=TCON
		fi

		# dedicated mp3 tool
		if [[ -z "$optTagValue" ]]
		then
			# --delete-frames needs the actual id3 frame name, not the friendly one
			# so anything needed will have to be manually mapped
			output="$(mid3v2 --quiet --delete-frames="$optTagName" "$optPath" 2>&1)"
		else
			# echo "optTagName: $optTagName"
			output="$(mid3v2 --quiet --"$optTagName"="$optTagValue" "$optPath" 2>&1)"
		fi

		# painfully ignore warnings
		output="$(echo "$output" | grep -Piv '^warning')"
		if [[ -n "$output" ]]
		then
			echo "$output"
		fi
	else
		# multipurpose tool
		exiftool -"$optTagName"="$optTagValue" "$optPath"
	fi
done
